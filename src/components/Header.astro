---
import { t } from '../lib/i18n';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lockup = `${base}/assets/endure-lockup.png`;
const events = await getCollection('events');
const count = events.length;
---

<header class="sticky top-0 z-40 backdrop-blur-xl bg-white/75 border-b border-[var(--color-ink-100)]/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href={base} class="flex items-center gap-3 group" aria-label="ENDURE Events">
      <img src={lockup} alt="ENDURE" class="h-7 w-auto transition group-hover:opacity-80" loading="eager" />
      <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[var(--color-brand-50)] text-[var(--color-brand-700)] text-[10px] font-semibold uppercase tracking-[0.14em]">
        Events
      </span>
    </a>

    <nav class="flex items-center gap-1.5 sm:gap-3 text-sm">
      <span class="hidden md:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-ink-100)] text-[var(--color-ink-700)] font-medium text-xs">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inline-flex w-full h-full rounded-full bg-[var(--color-brand-500)] opacity-60 animate-ping"></span>
          <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[var(--color-brand-500)]"></span>
        </span>
        {t('header.events', { count })}
      </span>

      <a href={`${base}/event-vorschlagen`}
        class="inline-flex px-3.5 py-1.5 rounded-full text-xs font-medium text-[var(--color-ink-700)] hover:text-[var(--color-brand-700)] hover:bg-[var(--color-brand-100)] transition">
        {t('header.cta')}
      </a>
    </nav>
  </div>
  <div class="h-px bg-gradient-to-r from-transparent via-[var(--color-brand-500)]/20 to-transparent"></div>
</header>
