---
import type { EventData } from '../lib/filters';
import { formatDateRange, t } from '../lib/i18n';
import { COUNTRY_LABELS, isRtf } from '../lib/types';

interface Props {
  event: EventData;
  compact?: boolean;
}

const { event, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/events/${event.slug}/`;
const start = new Date(event.dates.start);
const end = event.dates.end ? new Date(event.dates.end) : undefined;
const dateLabel = event.dates.confirmed ? formatDateRange(start, end) : t('event.date.tba');
const sportColor = event.sport === 'cycling' ? 'bg-[var(--color-brand-100)] text-[var(--color-brand-700)]' : 'bg-pink-100 text-pink-700';
const sportLabel =
  event.sport === 'cycling'
    ? isRtf(event.categories)
      ? t('sport.cycling.rtf')
      : t('filter.sport.cycling')
    : t('filter.sport.triathlon');
const countryFlag = COUNTRY_LABELS[event.country].flag;
---

<article class="group rounded-2xl bg-white border border-[var(--color-ink-100)] hover:border-[var(--color-brand-500)] hover:shadow-md transition overflow-hidden">
  <a href={href} class="block p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
      <span class={`inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full ${sportColor}`}>
        {event.sport === 'cycling'
          ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5"><circle cx="6" cy="15" r="4"/><circle cx="18" cy="15" r="4"/><path d="m6 15 4-8h4l4 8"/></svg>
          : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5"><path d="M2 12h4l3-7 4 14 3-7h6"/></svg>
        }
        {sportLabel}
      </span>
      <span class="text-xs text-[var(--color-ink-500)] text-right">{dateLabel}</span>
    </div>
    <h3 class="text-lg font-semibold leading-tight group-hover:text-[var(--color-brand-600)] mb-1">{event.name}</h3>
    <p class="text-sm text-[var(--color-ink-500)] mb-3">
      <span aria-hidden="true">{countryFlag}</span> {event.location.name}{event.location.region ? ` · ${event.location.region}` : ''}
    </p>
    {!compact && (
      <div class="flex flex-wrap gap-1.5 mb-3">
        {event.categories.map((c) => (
          <span class="text-xs px-2 py-0.5 rounded-md bg-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
        ))}
      </div>
    )}
    <div class="flex gap-4 text-xs text-[var(--color-ink-500)]">
      {event.distanceKm && <span><strong class="text-[var(--color-ink-900)]">{event.distanceKm}</strong> {t('event.distance.unit')}</span>}
      {event.elevationGainM && <span><strong class="text-[var(--color-ink-900)]">{event.elevationGainM}</strong> {t('event.elevation.unit')}</span>}
    </div>
  </a>
</article>
