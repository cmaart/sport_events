---
import { t } from '../lib/i18n';

interface Props {
  /** Tailwind margin overrides for context-specific spacing. */
  class?: string;
}

const { class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lockup = `${base}/assets/endure-lockup-white.png`;
const appUrl = 'https://endure-cycling.com/';

const features = [
  t('appPromo.feature.trainer'),
  t('appPromo.feature.workouts'),
  t('appPromo.feature.metrics'),
  t('appPromo.feature.routes'),
];
---

<section class={`mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 ${className}`} aria-labelledby="app-promo-title">
  <div class="relative overflow-hidden rounded-3xl bg-[var(--color-ink-900)] text-white shadow-xl">
    {/* Decorative brand glow */}
    <div class="absolute inset-0 -z-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-24 -right-16 w-[420px] h-[420px] rounded-full bg-[var(--color-brand-500)]/25 blur-3xl"></div>
      <div class="absolute -bottom-28 -left-20 w-[360px] h-[360px] rounded-full bg-[var(--color-accent-500)]/15 blur-3xl"></div>
    </div>

    <div class="relative z-10 grid gap-4 lg:gap-6 lg:grid-cols-[1fr_auto] lg:items-center p-5 sm:p-6 lg:px-8 lg:py-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-[10px] uppercase tracking-[0.14em] font-semibold text-white/90 mb-2.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-brand-500)]"></span>
          {t('appPromo.eyebrow')}
        </div>

        <h2 id="app-promo-title" class="text-xl sm:text-2xl font-bold tracking-tight leading-tight">
          {t('appPromo.title')}
        </h2>

        <p class="mt-1.5 text-sm text-white/70 leading-relaxed">
          {t('appPromo.subtitle')}
        </p>

        <ul class="mt-3 flex flex-wrap gap-2">
          {features.map((f) => (
            <li class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-white/80">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5 text-[var(--color-brand-500)]" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col items-start lg:items-end gap-2.5">
        <img src={lockup} alt="ENDURE" class="h-16 sm:h-20 w-auto opacity-90" loading="lazy" />
        <a
          href={appUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-semibold text-sm shadow-lg shadow-[var(--color-brand-500)]/20 transition"
        >
          {t('appPromo.cta')}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
