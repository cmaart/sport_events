---
import { t } from '../lib/i18n';
const base = import.meta.env.BASE_URL;
const lockup = `${base}assets/endure-lockup.png`.replace(/\/+/g, '/');
---

<footer class="border-t border-[var(--color-ink-100)] bg-white mt-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <div class="flex flex-col gap-2">
      <a
        href="https://endure-cycling.com"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center group"
        aria-label="ENDURE"
      >
        <img src={lockup} alt="ENDURE" class="h-7 w-auto transition group-hover:opacity-80" loading="lazy" />
      </a>
      <p class="text-xs italic text-[var(--color-ink-500)] tracking-wide">{t('footer.tagline')}</p>
    </div>

    <div class="text-sm text-[var(--color-ink-500)] flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
      <p>{t('footer.tiles')} · {t('footer.license')}</p>
      <div class="flex gap-4">
        <a href="https://endure-cycling.com" target="_blank" rel="noreferrer" class="hover:text-[var(--color-brand-600)]">endure-cycling.com</a>
        <a href="https://github.com/cmaart/sport_events" target="_blank" rel="noreferrer" class="hover:text-[var(--color-brand-600)]">{t('footer.source')}</a>
        <a href="https://github.com/cmaart/sport_events#event-hinzufügen" target="_blank" rel="noreferrer" class="hover:text-[var(--color-brand-600)]">{t('footer.contribute')}</a>
      </div>
    </div>
  </div>
</footer>
