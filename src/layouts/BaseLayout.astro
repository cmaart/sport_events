---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { t } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Override the og:image (absolute or relative to base). Defaults to /assets/og-image.png. */
  ogImage?: string;
  /** Override the canonical URL. Defaults to the current request URL resolved against site. */
  canonical?: string;
}

const { title, description = t('site.description'), ogImage, canonical } = Astro.props;
const pageTitle = title ? `${title} – ${t('site.title')}` : `${t('site.title')} – ${t('site.tagline')}`;
const base = import.meta.env.BASE_URL;

const ensureAbsolute = (path: string) => {
  if (/^https?:\/\//i.test(path)) return path;
  if (Astro.site) {
    return new URL(path.startsWith('/') ? path.slice(1) : path, Astro.site).toString();
  }
  return path;
};

const ogImagePath = ogImage ?? `${base}assets/og-image.png`.replace(/\/+/g, '/');
const ogImageUrl = ensureAbsolute(ogImagePath);

const canonicalUrl = canonical
  ? ensureAbsolute(canonical)
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.toString();

const favicon32 = `${base}favicon-32x32.png`.replace(/\/+/g, '/');
const faviconIco = `${base}favicon.ico`.replace(/\/+/g, '/');
const appleTouchIcon = `${base}apple-touch-icon.png`.replace(/\/+/g, '/');
const faviconSvg = `${base}favicon.svg`.replace(/\/+/g, '/');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2160" />
    <meta property="og:image:alt" content="ENDURE Events – Rennkalender 2026" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="ENDURE Events – Rennkalender 2026" />

    <meta name="theme-color" content="#F05D23" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="alternate icon" href={faviconIco} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <script is:inline>
      // Google Consent Mode v2: default-denied in EEA/UK/CH until the cookie
      // banner explicitly updates the state on user accept. This tells Google's
      // ad stack that consent is being managed externally, so Funding Choices
      // (Google's own CMP) won't inject its own banner.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH']
      });
    </script>

    <slot name="head" />
  </head>
  <body class="bg-[var(--color-surface-muted)] text-[var(--color-ink-900)] antialiased">
    <Header />
    <main class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
