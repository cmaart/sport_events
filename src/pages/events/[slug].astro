---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailMap from '../../components/islands/EventDetailMap';
import ShareButton from '../../components/islands/ShareButton';
import AppPromo from '../../components/AppPromo.astro';
import { formatDateRange, t } from '../../lib/i18n';
import { COUNTRY_LABELS, isRtf, seasonOf } from '../../lib/types';
import { collectLandingPaths, landingHref } from '../../lib/landing';
import { isFocus, FOCUS_SLUGS } from '../../lib/focus';
import { buildEventFacts } from '../../lib/event-facts';
import fs from 'node:fs';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.json$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const start = new Date(e.dates.start);
const end = e.dates.end ? new Date(e.dates.end) : undefined;
const year = seasonOf(start);
const slug = entry.id.replace(/\.json$/, '');
const dateLabel = e.dates.confirmed ? formatDateRange(start, end) : t('event.date.tba');

// Past confirmed events: noindex so Google concentrates index budget on live races.
// TBA/unconfirmed events stay indexable (their date is a best guess, likely upcoming).
const today = new Date();
today.setHours(0, 0, 0, 0);
const isPast = e.dates.confirmed && (end ?? start) < today;
// Index focus set (src/data/index-focus.json): only those pages are indexable.
// Everything else is noindex,follow — still linked, still served, but kept out
// of Google's quality assessment of the site. See scripts/select-index-focus.mjs.
const inFocus = isFocus(slug);
const noindex = isPast || !inFocus;
const deadlineLabel = e.registrationDeadline ? formatDateRange(new Date(e.registrationDeadline)) : undefined;

// Last content change of this event (written by astro.config.mjs from git
// history). Falls back to the build date in a shallow checkout.
const lastModMap: Record<string, string> = (() => {
  try {
    return JSON.parse(fs.readFileSync('.astro/event-lastmod.json', 'utf8'));
  } catch {
    return {};
  }
})();
const lastModified = lastModMap[slug] ? new Date(lastModMap[slug]) : new Date();
const facts = buildEventFacts(
  {
    ...e,
    dates: { start, end, confirmed: e.dates.confirmed },
    registrationDeadline: e.registrationDeadline ? new Date(e.registrationDeadline) : undefined,
  },
  lastModified,
  year,
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${e.location.lat},${e.location.lng}`;
// Organiser hero images are hotlinked originals (often 0.5–1 MB, 1920px+). Serve
// resized WebP via the wsrv.nl proxy for display; og:image and JSON-LD keep the
// original URL. onerror falls back to the original if the proxy can't fetch it.
const heroSrc = (url: string, w: number) =>
  `https://wsrv.nl/?url=${encodeURIComponent(url)}&w=${w}&h=${Math.round((w * 7) / 16)}&fit=cover&output=webp&q=80`;
const sportLabel =
  e.sport === 'cycling'
    ? isRtf(e.categories)
      ? t('sport.cycling.rtf')
      : t('filter.sport.cycling')
    : t('filter.sport.triathlon');
const sportColor = e.sport === 'cycling' ? 'bg-[var(--color-brand-100)] text-[var(--color-brand-700)]' : 'bg-pink-100 text-pink-700';
const country = COUNTRY_LABELS[e.country];

// Registration host (e.g. "raceresult.com") for the "Anmeldung über X" hint.
const registrationHost = e.registrationUrl
  ? (() => {
      try {
        return new URL(e.registrationUrl).hostname.replace(/^(www|my)\./, '');
      } catch {
        return undefined;
      }
    })()
  : undefined;

const startIso = start.toISOString().slice(0, 10);
const hasCourseElevation = (e.distances ?? []).some((d) => d.elevationGainM);
const hasCourseSplit = (e.distances ?? []).some((d) => d.split);

// SEO: title + description tailored for SERP snippets.
const locationParts = [e.location.name, e.location.region].filter(Boolean) as string[];
const locationLine = Array.from(new Set(locationParts)).join(', ');
const seoTitle = `${e.name}${e.dates.confirmed ? ` · ${dateLabel}` : ''} · ${locationLine}`;
const catLabel = e.categories[0];
const descPrefix = e.dates.confirmed
  ? `${sportLabel} · ${catLabel} am ${dateLabel} in ${locationLine}. `
  : `${sportLabel} · ${catLabel} ${year} in ${locationLine}. `;
const truncate = (s: string, max: number) => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > max * 0.7 ? cut.slice(0, lastSpace) : cut).replace(/[.,;:\s]+$/, '') + '…';
};
const seoDescription = truncate(descPrefix + e.description.replace(/\s+/g, ' ').trim(), 200);

// Structured data: SportsEvent — eligible for Google's event rich results.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}/events/${slug}/`;
const sportName = e.sport === 'cycling' ? 'Cycling' : 'Triathlon';

const sportsEventLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  '@id': pageUrl,
  name: e.name,
  description: e.description,
  startDate: start.toISOString().slice(0, 10),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  sport: sportName,
  url: pageUrl,
  inLanguage: 'de-DE',
  image: e.imageUrl ?? `${siteUrl}/assets/og-image.png`,
  location: {
    '@type': 'Place',
    name: e.location.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: e.location.name,
      ...(e.location.region ? { addressRegion: e.location.region } : {}),
      addressCountry: e.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: e.location.lat,
      longitude: e.location.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: t('site.title'),
    url: `${siteUrl}/`,
  },
};
// Google's Event rich-result validator warns on missing endDate/offers/performer.
// endDate: a one-day race ends the day it starts. offers: the registration page,
// or the official site when registration isn't linked yet (price is unknown).
sportsEventLd.endDate = (end ?? start).toISOString().slice(0, 10);
if (e.websiteUrl) sportsEventLd.sameAs = e.websiteUrl;
const offerUrl = e.registrationUrl ?? e.websiteUrl;
if (offerUrl) {
  sportsEventLd.offers = {
    '@type': 'Offer',
    url: offerUrl,
    availability: 'https://schema.org/InStock',
    validFrom: new Date().toISOString().slice(0, 10),
    ...(e.registrationDeadline ? { validThrough: new Date(e.registrationDeadline).toISOString().slice(0, 10) } : {}),
    category: 'Anmeldung',
  };
  const feeNum = e.entryFee?.match(/(\d+(?:[.,]\d+)?)/)?.[1];
  if (feeNum) {
    Object.assign(sportsEventLd.offers as Record<string, unknown>, {
      price: feeNum.replace(',', '.'),
      priceCurrency: 'EUR',
    });
  }
}
if (e.participantLimit) sportsEventLd.maximumAttendeeCapacity = e.participantLimit;
sportsEventLd.dateModified = lastModified.toISOString().slice(0, 10);
if (e.startTime && e.dates.confirmed) sportsEventLd.doorTime = `${startIso}T${e.startTime}:00`;

// Landing page for this sport+country (only exists when the country has
// enough events) — linked from the breadcrumb so every event page passes a
// keyword-anchored internal link to its country landing page.
const allEntries = await getCollection('events');
const landing = collectLandingPaths(allEntries).find(
  (l) => l.sport === e.sport && l.country === e.country && l.year === year,
);
const landingTitle = t(
  e.sport === 'cycling' ? 'landing.title.cycling' : 'landing.title.triathlon',
  { country: country.name, year },
);
const landingUrl = landing ? landingHref(base, landing) : undefined;
const landingAbsUrl = landing ? landingHref(siteUrl, landing) : undefined;

// Other editions of the same event (`<slug>-2026` ↔ `<slug>-2027`): a past
// page keeps passing visitors and link equity on to the next season.
const baseSlug = slug.replace(/-\d{4}$/, '');
const otherEditions = allEntries
  .map((en) => ({ slug: en.id.replace(/\.json$/, ''), name: en.data.name, year: seasonOf(en.data.dates.start) }))
  .filter((o) => o.slug !== slug && o.slug.replace(/-\d{4}$/, '') === baseSlug)
  .sort((a, b) => b.year - a.year);

// Related focus events: same sport + country + season, nearest by date. Every
// event page (including the ~1300 noindexed ones) links into the indexable set,
// so internal link equity concentrates on the pages Google is asked to index.
// Pages in countries without focus events fall back to the same sport across
// all countries, so no page is a dead end for the crawler.
const focusPool = allEntries.filter((en) => {
  const s2 = en.id.replace(/\.json$/, '');
  return s2 !== slug && FOCUS_SLUGS.has(s2) && en.data.sport === e.sport && seasonOf(en.data.dates.start) === year;
});
const sameCountryPool = focusPool.filter((en) => en.data.country === e.country);
const relatedSameCountry = sameCountryPool.length > 0;
const relatedFocus = (relatedSameCountry ? sameCountryPool : focusPool)
  .map((en) => ({
    slug: en.id.replace(/\.json$/, ''),
    name: en.data.name,
    location: en.data.location.name,
    start: new Date(en.data.dates.start),
    confirmed: en.data.dates.confirmed,
    gap: Math.abs(+new Date(en.data.dates.start) - +start),
  }))
  .sort((a, b) => a.gap - b.gap)
  .slice(0, 6)
  .sort((a, b) => +a.start - +b.start);
const sportPlural = e.sport === 'cycling' ? t('hero.stat.cycling') : t('hero.stat.triathlon');

// Breadcrumbs help Google show the "ENDURE Events › Event" trail in results.
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('site.title'), item: `${siteUrl}/` },
    ...(landing
      ? [{ '@type': 'ListItem', position: 2, name: landingTitle, item: landingAbsUrl }]
      : []),
    { '@type': 'ListItem', position: landing ? 3 : 2, name: e.name, item: pageUrl },
  ],
};
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={e.imageUrl} ogImageAlt={e.imageUrl ? e.name : undefined} noindex={noindex} titleSuffix={t('event.titleSuffix')}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(sportsEventLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbsLd)}
  />
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href={`${base}/`} class="inline-flex items-center gap-1.5 text-[var(--color-brand-600)] hover:underline">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="m15 18-6-6 6-6"/></svg>
            {t('landing.breadcrumb.home')}
          </a>
        </li>
        {landing && (
          <>
            <li aria-hidden="true" class="text-[var(--color-ink-300)]">/</li>
            <li>
              <a href={landingUrl} class="text-[var(--color-brand-600)] hover:underline">
                {landingTitle}
              </a>
            </li>
          </>
        )}
      </ol>
    </nav>

    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class={`inline-flex items-center text-xs uppercase tracking-wide font-medium px-2.5 py-1 rounded-full ${sportColor}`}>
        {sportLabel}
      </span>
      {e.categories.map((c: string) => (
        <span class="text-xs px-2 py-0.5 rounded bg-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
      ))}
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">{e.name}</h1>
    <p class="text-lg text-[var(--color-ink-500)] mb-4">
      <span aria-hidden="true">{country.flag}</span> {e.location.name}{e.location.region ? ` · ${e.location.region}` : ''}
    </p>
    {/* Quotable facts paragraph: one plain statement of date, place, courses,
        fee, deadline, limit, plus provenance. This is what answer engines cite. */}
    <p class="text-[15px] sm:text-base text-[var(--color-ink-900)] leading-relaxed max-w-prose mb-1">{facts.text}</p>
    <p class="text-xs text-[var(--color-ink-500)] mb-6">
      {facts.source}
      <time datetime={lastModified.toISOString().slice(0, 10)} class="sr-only">{lastModified.toISOString().slice(0, 10)}</time>
    </p>

    {e.imageUrl && (
      <div class="mb-6 rounded-2xl overflow-hidden border border-[var(--color-ink-100)] shadow-sm aspect-[16/7]">
        <img
          src={heroSrc(e.imageUrl, 1200)}
          srcset={`${heroSrc(e.imageUrl, 640)} 640w, ${heroSrc(e.imageUrl, 960)} 960w, ${heroSrc(e.imageUrl, 1200)} 1200w, ${heroSrc(e.imageUrl, 1600)} 1600w`}
          sizes="(min-width: 1024px) 896px, 100vw"
          alt={e.name}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="525"
          onerror={`this.onerror=null;this.removeAttribute('srcset');this.src=${JSON.stringify(e.imageUrl)}`}
        />
      </div>
    )}

    {/* Prominent above-fold CTA: date + primary registration link */}
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-10 p-4 sm:p-5 rounded-2xl border border-[var(--color-ink-100)] bg-white shadow-sm">
      <div class="flex items-center gap-2 text-sm sm:text-base">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-[var(--color-brand-600)]" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        {e.dates.confirmed ? (
          <time datetime={startIso} class="font-semibold text-[var(--color-ink-900)]">{dateLabel}</time>
        ) : (
          <span class="font-semibold text-[var(--color-ink-700)]">{dateLabel}</span>
        )}
      </div>
      <div class="ml-auto flex flex-wrap gap-2">
        {e.registrationUrl && (
          <a href={e.registrationUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-semibold text-sm shadow-sm transition">
            {t('event.registration.cta')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
        {e.websiteUrl && (
          <a href={e.websiteUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-[var(--color-ink-300)] hover:border-[var(--color-brand-500)] font-medium text-sm transition">
            {t('event.website')}
          </a>
        )}
        <ShareButton client:idle url={pageUrl} title={e.name} />
      </div>
    </div>

    <section aria-labelledby="facts" class="mb-10">
      <h2 id="facts" class="text-xl sm:text-2xl font-semibold tracking-tight mb-4">{t('event.section.facts')}</h2>
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.date')}</dt>
          <dd class="font-semibold text-sm">
            {e.dates.confirmed
              ? <time datetime={startIso}>{dateLabel}</time>
              : <span>{dateLabel}</span>}
          </dd>
        </div>
        <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.country')}</dt>
          <dd class="font-semibold text-sm"><span aria-hidden="true">{country.flag}</span> {country.name}</dd>
          {e.location.region && <dd class="text-xs text-[var(--color-ink-500)] mt-0.5">{e.location.region}</dd>}
        </div>
        {e.distanceKm && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.distance')}</dt>
            <dd class="font-semibold text-sm">{e.distanceKm} {t('event.distance.unit')}</dd>
          </div>
        )}
        {e.elevationGainM && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.elevation')}</dt>
            <dd class="font-semibold text-sm">{e.elevationGainM} {t('event.elevation.unit')}</dd>
          </div>
        )}
        {e.entryFee && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.entryFee')}</dt>
            <dd class="font-semibold text-sm">{e.entryFee}</dd>
          </div>
        )}
        {deadlineLabel && e.registrationDeadline && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.registrationDeadline')}</dt>
            <dd class="font-semibold text-sm"><time datetime={new Date(e.registrationDeadline).toISOString().slice(0, 10)}>{deadlineLabel}</time></dd>
          </div>
        )}
        {e.startTime && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.startTime')}</dt>
            <dd class="font-semibold text-sm">{t('event.startTime.value', { time: e.startTime })}</dd>
          </div>
        )}
        {e.participantLimit && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.participantLimit')}</dt>
            <dd class="font-semibold text-sm">{e.participantLimit.toLocaleString('de-DE')}</dd>
          </div>
        )}
      </dl>
    </section>

    {e.distances && e.distances.length > 0 && (
      <section aria-labelledby="courses" class="mb-10">
        <h2 id="courses" class="text-xl sm:text-2xl font-semibold tracking-tight mb-4">{t('event.section.courses')}</h2>
        <div class="overflow-x-auto rounded-xl border border-[var(--color-ink-100)] bg-white">
          <table class="w-full text-sm">
            <thead class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] bg-[var(--color-surface)]">
              <tr>
                <th scope="col" class="text-left font-medium px-4 py-2.5">{t('event.course.name')}</th>
                <th scope="col" class="text-right font-medium px-4 py-2.5">{t('event.course.km')}</th>
                {hasCourseElevation && <th scope="col" class="text-right font-medium px-4 py-2.5">{t('event.course.elevation')}</th>}
                {hasCourseSplit && <th scope="col" class="text-left font-medium px-4 py-2.5">{t('event.course.split')}</th>}
              </tr>
            </thead>
            <tbody>
              {e.distances.map((d) => (
                <tr class="border-t border-[var(--color-ink-100)]">
                  <th scope="row" class="text-left font-semibold px-4 py-2.5">{d.name}</th>
                  <td class="text-right px-4 py-2.5 tabular-nums">{d.km.toLocaleString('de-DE')} {t('event.distance.unit')}</td>
                  {hasCourseElevation && <td class="text-right px-4 py-2.5 tabular-nums">{d.elevationGainM ? `${d.elevationGainM.toLocaleString('de-DE')} ${t('event.elevation.unit')}` : '–'}</td>}
                  {hasCourseSplit && <td class="text-left px-4 py-2.5 text-[var(--color-ink-700)]">{d.split ?? '–'}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section aria-labelledby="about" class="mb-10">
      <h2 id="about" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{isRtf(e.categories) ? t('event.section.about.rtf') : t('event.section.about')}</h2>
      <div class="prose prose-slate max-w-none">
        <p class="text-[var(--color-ink-700)] whitespace-pre-line leading-relaxed">{e.description}</p>
      </div>
    </section>

    <section aria-labelledby="registration" class="mb-10">
      <h2 id="registration" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{t('event.section.registration')}</h2>
      <p class="text-[var(--color-ink-700)] leading-relaxed mb-4">
        {e.dates.confirmed
          ? t('event.registration.intro.confirmed', { sport: sportLabel, date: dateLabel, location: e.location.name })
          : t('event.registration.intro.tba', { year })}
      </p>
      <div class="flex flex-wrap gap-3">
        {e.registrationUrl && (
          <a href={e.registrationUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-medium text-sm transition">
            {t('event.registration')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
        {e.websiteUrl && (
          <a href={e.websiteUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white border border-[var(--color-ink-300)] hover:border-[var(--color-brand-500)] font-medium text-sm transition">
            {t('event.website')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
        <ShareButton client:idle url={pageUrl} title={e.name} />
      </div>
      {registrationHost && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.host', { host: registrationHost })}</p>
      )}
      {!e.registrationUrl && e.websiteUrl && e.dates.confirmed && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.viaWebsite')}</p>
      )}
      {!e.registrationUrl && !e.websiteUrl && !e.dates.confirmed && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.tba')}</p>
      )}
    </section>

    {otherEditions.length > 0 && (
      <section aria-labelledby="editions" class="mb-10">
        <h2 id="editions" class="text-sm font-semibold uppercase tracking-wide text-[var(--color-ink-500)] mb-3">{t('event.editions.label')}</h2>
        <ul class="flex flex-wrap gap-2">
          {otherEditions.map((o) => (
            <li>
              <a href={`${base}/events/${o.slug}/`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[var(--color-ink-200)] hover:border-[var(--color-brand-500)] text-sm font-medium transition">
                {t('event.editions.link', { name: o.name, year: o.year })}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedFocus.length > 0 && (
      <section aria-labelledby="related" class="mb-10">
        <h2 id="related" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">
          {relatedSameCountry
            ? t('event.related.heading', { sport: sportPlural, country: country.name, year })
            : t('event.related.heading.any', { sport: sportPlural, year })}
        </h2>
        <ul class="grid gap-2 sm:grid-cols-2">
          {relatedFocus.map((r) => (
            <li>
              <a href={`${base}/events/${r.slug}/`}
                class="flex items-baseline justify-between gap-3 rounded-xl bg-white border border-[var(--color-ink-100)] hover:border-[var(--color-brand-500)] px-4 py-3 transition">
                <span class="font-medium text-sm leading-snug">{r.name}<span class="block text-xs font-normal text-[var(--color-ink-500)]">{r.location}</span></span>
                <span class="text-xs text-[var(--color-ink-500)] whitespace-nowrap">{r.confirmed ? formatDateRange(r.start) : t('event.date.tba')}</span>
              </a>
            </li>
          ))}
        </ul>
        {landingUrl && relatedSameCountry && (
          <a href={landingUrl} class="inline-block mt-3 text-sm text-[var(--color-brand-600)] hover:underline">
            {t('event.related.all', { sport: sportPlural, country: country.name, year })} →
          </a>
        )}
      </section>
    )}

    <section aria-labelledby="location" class="mb-6">
      <h2 id="location" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{t('event.section.location')}</h2>
      <EventDetailMap
        client:only="preact"
        lat={e.location.lat}
        lng={e.location.lng}
        name={e.name}
        sport={e.sport}
        locationName={e.location.name}
      />
      <div class="rounded-2xl bg-white border border-[var(--color-ink-100)] p-5 mt-4">
        <p class="font-semibold mb-1">{e.location.name}</p>
        <p class="text-sm text-[var(--color-ink-500)] mb-3">{e.location.region ? `${e.location.region} · ` : ''}{e.location.lat.toFixed(4)}, {e.location.lng.toFixed(4)}</p>
        <a href={mapUrl} target="_blank" rel="noreferrer" class="text-sm text-[var(--color-brand-600)] hover:underline">
          {t('event.openMap')} →
        </a>
      </div>
    </section>
  </article>

  <AppPromo class="mb-12" placement="event-detail" />
</BaseLayout>
