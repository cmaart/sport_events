---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailMap from '../../components/islands/EventDetailMap';
import { formatDateRange, t } from '../../lib/i18n';
import { COUNTRY_LABELS } from '../../lib/types';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.json$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const start = new Date(e.dates.start);
const end = e.dates.end ? new Date(e.dates.end) : undefined;
const dateLabel = e.dates.confirmed ? formatDateRange(start, end) : t('event.date.tba');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const osmUrl = `https://www.openstreetmap.org/?mlat=${e.location.lat}&mlon=${e.location.lng}#map=13/${e.location.lat}/${e.location.lng}`;
const sportLabel = e.sport === 'cycling' ? t('filter.sport.cycling') : t('filter.sport.triathlon');
const sportColor = e.sport === 'cycling' ? 'bg-[var(--color-brand-100)] text-[var(--color-brand-700)]' : 'bg-pink-100 text-pink-700';
const country = COUNTRY_LABELS[e.country];

// Registration host (e.g. "raceresult.com") for the "Anmeldung über X" hint.
const registrationHost = e.registrationUrl
  ? (() => {
      try {
        return new URL(e.registrationUrl).hostname.replace(/^(www|my)\./, '');
      } catch {
        return undefined;
      }
    })()
  : undefined;

const startIso = start.toISOString().slice(0, 10);

// SEO: title + description tailored for SERP snippets.
const locationParts = [e.location.name, e.location.region].filter(Boolean) as string[];
const locationLine = Array.from(new Set(locationParts)).join(', ');
const seoTitle = `${e.name}${e.dates.confirmed ? ` · ${dateLabel}` : ''} · ${locationLine}`;
const descPrefix = e.dates.confirmed
  ? `${sportLabel} am ${dateLabel} in ${locationLine}. `
  : `${sportLabel} 2026 in ${locationLine}. `;
const truncate = (s: string, max: number) => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > max * 0.7 ? cut.slice(0, lastSpace) : cut).replace(/[.,;:\s]+$/, '') + '…';
};
const seoDescription = truncate(descPrefix + e.description.replace(/\s+/g, ' ').trim(), 200);

// Structured data: SportsEvent — eligible for Google's event rich results.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}/events/${entry.id.replace(/\.json$/, '')}`;
const sportName = e.sport === 'cycling' ? 'Cycling' : 'Triathlon';

const sportsEventLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: e.name,
  description: e.description,
  startDate: start.toISOString().slice(0, 10),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  sport: sportName,
  url: pageUrl,
  inLanguage: 'de-DE',
  image: `${siteUrl}/assets/og-image.png`,
  location: {
    '@type': 'Place',
    name: e.location.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: e.location.name,
      ...(e.location.region ? { addressRegion: e.location.region } : {}),
      addressCountry: e.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: e.location.lat,
      longitude: e.location.lng,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: t('site.title'),
    url: `${siteUrl}/`,
  },
};
if (end) sportsEventLd.endDate = end.toISOString().slice(0, 10);
if (e.registrationUrl) {
  sportsEventLd.offers = {
    '@type': 'Offer',
    url: e.registrationUrl,
    availability: 'https://schema.org/InStock',
    category: 'Anmeldung',
  };
}

// Breadcrumbs help Google show the "ENDURE Events › Event" trail in results.
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('site.title'), item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: e.name, item: pageUrl },
  ],
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(sportsEventLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbsLd)}
  />
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
    <a href={`${base}/`} class="inline-flex items-center gap-1.5 text-sm text-[var(--color-brand-600)] hover:underline mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="m15 18-6-6 6-6"/></svg>
      {t('event.back')}
    </a>

    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class={`inline-flex items-center text-xs uppercase tracking-wide font-medium px-2.5 py-1 rounded-full ${sportColor}`}>
        {sportLabel}
      </span>
      {e.categories.map((c: string) => (
        <span class="text-xs px-2 py-0.5 rounded bg-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
      ))}
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">{e.name}</h1>
    <p class="text-lg text-[var(--color-ink-500)] mb-6">
      <span aria-hidden="true">{country.flag}</span> {e.location.name}{e.location.region ? ` · ${e.location.region}` : ''}
    </p>

    {/* Prominent above-fold CTA: date + primary registration link */}
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-10 p-4 sm:p-5 rounded-2xl border border-[var(--color-ink-100)] bg-white shadow-sm">
      <div class="flex items-center gap-2 text-sm sm:text-base">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-[var(--color-brand-600)]" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        {e.dates.confirmed ? (
          <time datetime={startIso} class="font-semibold text-[var(--color-ink-900)]">{dateLabel}</time>
        ) : (
          <span class="font-semibold text-[var(--color-ink-700)]">{dateLabel}</span>
        )}
      </div>
      <div class="ml-auto flex flex-wrap gap-2">
        {e.registrationUrl && (
          <a href={e.registrationUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-semibold text-sm shadow-sm transition">
            {t('event.registration.cta')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
        {e.websiteUrl && (
          <a href={e.websiteUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-[var(--color-ink-300)] hover:border-[var(--color-brand-500)] font-medium text-sm transition">
            {t('event.website')}
          </a>
        )}
      </div>
    </div>

    <section aria-labelledby="facts" class="mb-10">
      <h2 id="facts" class="text-xl sm:text-2xl font-semibold tracking-tight mb-4">{t('event.section.facts')}</h2>
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.date')}</dt>
          <dd class="font-semibold text-sm">
            {e.dates.confirmed
              ? <time datetime={startIso}>{dateLabel}</time>
              : <span>{dateLabel}</span>}
          </dd>
        </div>
        <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
          <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.country')}</dt>
          <dd class="font-semibold text-sm"><span aria-hidden="true">{country.flag}</span> {country.name}</dd>
          {e.location.region && <dd class="text-xs text-[var(--color-ink-500)] mt-0.5">{e.location.region}</dd>}
        </div>
        {e.distanceKm && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.distance')}</dt>
            <dd class="font-semibold text-sm">{e.distanceKm} {t('event.distance.unit')}</dd>
          </div>
        )}
        {e.elevationGainM && (
          <div class="rounded-xl bg-white border border-[var(--color-ink-100)] p-4">
            <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-500)] mb-1">{t('event.elevation')}</dt>
            <dd class="font-semibold text-sm">{e.elevationGainM} {t('event.elevation.unit')}</dd>
          </div>
        )}
      </dl>
    </section>

    <section aria-labelledby="about" class="mb-10">
      <h2 id="about" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{t('event.section.about')}</h2>
      <div class="prose prose-slate max-w-none">
        <p class="text-[var(--color-ink-700)] whitespace-pre-line leading-relaxed">{e.description}</p>
      </div>
    </section>

    <section aria-labelledby="registration" class="mb-10">
      <h2 id="registration" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{t('event.section.registration')}</h2>
      <p class="text-[var(--color-ink-700)] leading-relaxed mb-4">
        {e.dates.confirmed
          ? t('event.registration.intro.confirmed', { sport: sportLabel, date: dateLabel, location: e.location.name })
          : t('event.registration.intro.tba')}
      </p>
      <div class="flex flex-wrap gap-3">
        {e.registrationUrl && (
          <a href={e.registrationUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-medium text-sm transition">
            {t('event.registration')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
        {e.websiteUrl && (
          <a href={e.websiteUrl} target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white border border-[var(--color-ink-300)] hover:border-[var(--color-brand-500)] font-medium text-sm transition">
            {t('event.website')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )}
      </div>
      {registrationHost && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.host', { host: registrationHost })}</p>
      )}
      {!e.registrationUrl && e.websiteUrl && e.dates.confirmed && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.viaWebsite')}</p>
      )}
      {!e.registrationUrl && !e.websiteUrl && !e.dates.confirmed && (
        <p class="text-xs text-[var(--color-ink-500)] mt-3">{t('event.registration.tba')}</p>
      )}
    </section>

    <section aria-labelledby="location" class="mb-6">
      <h2 id="location" class="text-xl sm:text-2xl font-semibold tracking-tight mb-3">{t('event.section.location')}</h2>
      <EventDetailMap
        client:only="preact"
        lat={e.location.lat}
        lng={e.location.lng}
        name={e.name}
        sport={e.sport}
        locationName={e.location.name}
      />
      <div class="rounded-2xl bg-white border border-[var(--color-ink-100)] p-5 mt-4">
        <p class="font-semibold mb-1">{e.location.name}</p>
        <p class="text-sm text-[var(--color-ink-500)] mb-3">{e.location.region ? `${e.location.region} · ` : ''}{e.location.lat.toFixed(4)}, {e.location.lng.toFixed(4)}</p>
        <a href={osmUrl} target="_blank" rel="noreferrer" class="text-sm text-[var(--color-brand-600)] hover:underline">
          {t('event.openMap')} →
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
