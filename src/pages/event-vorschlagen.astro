---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const thankYouUrl = `${siteUrl}/event-vorgeschlagen`;
const formspreeEndpoint = 'https://formspree.io/f/xkoejwkn';
---

<BaseLayout title={t('submit.title')} description={t('submit.subtitle')}>
  <article class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <a href={`${base}/`} class="inline-flex items-center gap-1.5 text-sm text-[var(--color-brand-600)] hover:underline mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="m15 18-6-6 6-6"/></svg>
      {t('event.back')}
    </a>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">{t('submit.title')}</h1>
    <p class="text-base text-[var(--color-ink-700)] leading-relaxed mb-8">{t('submit.subtitle')}</p>

    <form action={formspreeEndpoint} method="POST" class="space-y-5">
      <input type="hidden" name="_next" value={thankYouUrl} />
      <input type="hidden" name="_subject" value="Event-Vorschlag (ENDURE Events)" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" aria-hidden="true" />

      <div>
        <label for="name" class="block text-sm font-medium text-[var(--color-ink-700)] mb-1">
          {t('submit.field.name')} <span class="text-[var(--color-brand-600)]" aria-label={t('submit.required')}>*</span>
        </label>
        <input id="name" name="Eventname" type="text" required maxlength="200" autofocus
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-ink-200)] focus:outline-none focus:border-[var(--color-brand-500)] focus:ring-2 focus:ring-[var(--color-brand-500)]/20" />
        <p class="text-xs text-[var(--color-ink-500)] mt-1">{t('submit.field.name.help')}</p>
      </div>

      <div>
        <label for="websiteUrl" class="block text-sm font-medium text-[var(--color-ink-700)] mb-1">
          {t('submit.field.websiteUrl')} <span class="text-[var(--color-brand-600)]" aria-label={t('submit.required')}>*</span>
        </label>
        <input id="websiteUrl" name="Website" type="url" required placeholder="https://example.com"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-ink-200)] focus:outline-none focus:border-[var(--color-brand-500)] focus:ring-2 focus:ring-[var(--color-brand-500)]/20" />
        <p class="text-xs text-[var(--color-ink-500)] mt-1">{t('submit.field.websiteUrl.help')}</p>
      </div>

      <div>
        <label for="note" class="block text-sm font-medium text-[var(--color-ink-700)] mb-1">
          {t('submit.field.note')}
        </label>
        <textarea id="note" name="Notiz" rows="3" maxlength="500"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-ink-200)] focus:outline-none focus:border-[var(--color-brand-500)] focus:ring-2 focus:ring-[var(--color-brand-500)]/20"></textarea>
        <p class="text-xs text-[var(--color-ink-500)] mt-1">{t('submit.field.note.help')}</p>
      </div>

      <div>
        <label for="contactEmail" class="block text-sm font-medium text-[var(--color-ink-700)] mb-1">
          {t('submit.field.contactEmail')}
        </label>
        <input id="contactEmail" name="email" type="email"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-ink-200)] focus:outline-none focus:border-[var(--color-brand-500)] focus:ring-2 focus:ring-[var(--color-brand-500)]/20" />
        <p class="text-xs text-[var(--color-ink-500)] mt-1">{t('submit.field.contactEmail.help')}</p>
      </div>

      <div class="pt-2">
        <button type="submit"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--color-brand-500)] hover:bg-[var(--color-brand-600)] text-white font-semibold text-sm shadow-sm transition">
          {t('submit.submit')}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="w-4 h-4"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </button>
      </div>
    </form>
  </article>
</BaseLayout>
