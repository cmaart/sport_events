---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsExplorer from '../components/islands/EventsExplorer';
import EventCard from '../components/EventCard.astro';
import AppPromo from '../components/AppPromo.astro';
import { t } from '../lib/i18n';
import type { EventData } from '../lib/filters';

const entries = await getCollection('events');
const events: EventData[] = entries.map((entry) => ({
  slug: entry.id.replace(/\.json$/, ''),
  id: entry.data.id,
  name: entry.data.name,
  sport: entry.data.sport,
  categories: entry.data.categories,
  country: entry.data.country,
  dates: {
    start: entry.data.dates.start.toISOString(),
    end: entry.data.dates.end?.toISOString(),
    confirmed: entry.data.dates.confirmed,
  },
  location: entry.data.location,
  websiteUrl: entry.data.websiteUrl,
  registrationUrl: entry.data.registrationUrl,
  imageUrl: entry.data.imageUrl,
  description: entry.data.description,
  distanceKm: entry.data.distanceKm,
  elevationGainM: entry.data.elevationGainM,
}));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const total = events.length;
const cyclingCount = events.filter((e) => e.sport === 'cycling').length;
const triathlonCount = events.filter((e) => e.sport === 'triathlon').length;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;

const organizationLd = {
  '@type': 'Organization',
  '@id': orgId,
  name: t('site.title'),
  url: `${siteUrl}/`,
  logo: `${siteUrl}/assets/endure-mark-black.png`,
  sameAs: ['https://endure-cycling.com'],
};

const websiteLd = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${siteUrl}/`,
  name: t('site.title'),
  description: t('site.description'),
  inLanguage: 'de-DE',
  publisher: { '@id': orgId },
};

const upcoming = events
  .filter((e) => e.dates.confirmed)
  .map((e) => ({ ...e, _start: new Date(e.dates.start) }))
  .filter((e) => e._start >= new Date())
  .sort((a, b) => a._start.getTime() - b._start.getTime())
  .slice(0, 25);

const itemListLd = {
  '@type': 'ItemList',
  name: `${t('site.title')} – ${t('site.tagline')}`,
  numberOfItems: upcoming.length,
  itemListElement: upcoming.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/events/${e.slug}`,
    name: e.name,
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationLd, websiteLd, itemListLd],
};
---

<BaseLayout>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <section class="relative overflow-hidden border-b border-[var(--color-ink-100)] bg-[var(--color-surface)]">
    {/* Background: layered mesh-style gradient + dotted grid + topographic curves */}
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-white via-[#fff6f1] to-[var(--color-surface-muted)]"></div>
      <div class="absolute -top-32 -right-20 w-[520px] h-[520px] rounded-full bg-gradient-to-br from-[var(--color-brand-500)]/15 via-[var(--color-brand-500)]/5 to-transparent blur-3xl"></div>
      <div class="absolute -bottom-40 -left-32 w-[480px] h-[480px] rounded-full bg-gradient-to-tr from-[var(--color-accent-500)]/10 via-[var(--color-accent-500)]/5 to-transparent blur-3xl"></div>

      {/* Dotted grid overlay */}
      <svg class="absolute inset-0 w-full h-full opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="dotgrid" width="28" height="28" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1.5" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dotgrid)" />
      </svg>

      {/* Topographic decoration on the right (alpine reference) */}
      <svg class="absolute right-0 top-0 h-full w-1/2 hidden lg:block text-[var(--color-brand-500)]/15"
        viewBox="0 0 600 600" fill="none" stroke="currentColor" stroke-width="1" preserveAspectRatio="xMaxYMid slice">
        <path d="M-50 480 C 90 460, 160 380, 270 420 S 460 360, 620 400" />
        <path d="M-50 440 C 100 420, 170 340, 280 380 S 470 320, 620 360" />
        <path d="M-50 400 C 110 380, 180 300, 290 340 S 480 280, 620 320" />
        <path d="M-50 360 C 120 340, 190 260, 300 300 S 490 240, 620 280" />
        <path d="M-50 320 C 130 300, 200 220, 310 260 S 500 200, 620 240" />
        <path d="M-50 280 C 140 260, 210 180, 320 220 S 510 160, 620 200" />
        <path d="M-50 240 C 150 220, 220 140, 330 180 S 520 120, 620 160" />
      </svg>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 sm:pt-5 lg:pt-6 pb-4 sm:pb-5 lg:pb-6">
      <div class="grid lg:grid-cols-[1fr_auto] gap-4 lg:gap-12 items-center">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/80 backdrop-blur border border-[var(--color-ink-100)] text-[10px] uppercase tracking-[0.14em] font-semibold text-[var(--color-brand-700)] shadow-sm">
              <span class="relative flex w-1.5 h-1.5">
                <span class="absolute inline-flex w-full h-full rounded-full bg-[var(--color-brand-500)] opacity-70 animate-ping"></span>
                <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-[var(--color-brand-500)]"></span>
              </span>
              {t('hero.eyebrow')}
            </div>
          </div>

          <h1 class="text-[clamp(1.375rem,2.5vw,1.875rem)] font-bold tracking-[-0.03em] leading-[1.15] text-[var(--color-ink-900)]">
            {t('hero.title.line1')}
            <span class="gradient-text">
              {t('hero.title.line2')}
            </span>
          </h1>

          <p class="mt-1.5 text-sm text-[var(--color-ink-500)] max-w-2xl leading-relaxed">
            {t('hero.subtitle')}
          </p>

          <div class="mt-3 flex flex-wrap gap-2">
            <a href="#explore"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-ink-900)] hover:bg-[var(--color-brand-700)] text-white font-medium text-sm shadow-lg shadow-[var(--color-ink-900)]/10 transition">
              {t('hero.cta.explore')}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="w-4 h-4"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </a>
            <a href={`${base}/event-vorschlagen`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white hover:bg-[var(--color-ink-100)] border border-[var(--color-ink-300)] text-[var(--color-ink-900)] font-medium text-sm transition">
              {t('hero.cta.contribute')}
            </a>
          </div>
        </div>

        {/* Stat strip on the right (desktop) / below (mobile) */}
        <dl class="grid grid-cols-3 gap-2 lg:gap-3 lg:min-w-[260px]">
          <div class="rounded-xl bg-white/80 backdrop-blur border border-[var(--color-ink-100)] px-3 py-2 shadow-sm">
            <dt class="text-[9px] uppercase tracking-wider font-semibold text-[var(--color-ink-500)]">{t('hero.stat.events')}</dt>
            <dd class="text-xl lg:text-2xl font-bold tracking-tight text-[var(--color-ink-900)] tabular-nums">{total}</dd>
          </div>
          <div class="rounded-xl bg-white/80 backdrop-blur border border-[var(--color-ink-100)] px-3 py-2 shadow-sm">
            <dt class="text-[9px] uppercase tracking-wider font-semibold text-[var(--color-brand-700)]">{t('hero.stat.cycling')}</dt>
            <dd class="text-xl lg:text-2xl font-bold tracking-tight text-[var(--color-ink-900)] tabular-nums">{cyclingCount}</dd>
          </div>
          <div class="rounded-xl bg-white/80 backdrop-blur border border-[var(--color-ink-100)] px-3 py-2 shadow-sm">
            <dt class="text-[9px] uppercase tracking-wider font-semibold text-[var(--color-accent-600)]">{t('hero.stat.triathlon')}</dt>
            <dd class="text-xl lg:text-2xl font-bold tracking-tight text-[var(--color-ink-900)] tabular-nums">{triathlonCount}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <AppPromo class="mt-6 mb-2" />

  {/* Server-rendered upcoming events: real, crawlable HTML content — the
      interactive explorer below loads its data client-side, so this section
      is what search engines (and no-JS visitors) actually see. */}
  {upcoming.length > 0 && (
    <section aria-labelledby="upcoming-heading" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
        <h2 id="upcoming-heading" class="text-xl sm:text-2xl font-semibold tracking-tight">
          {t('home.upcoming.title')}
        </h2>
        <a href="#explore" class="text-sm text-[var(--color-brand-600)] hover:underline">
          {t('home.upcoming.cta', { count: total })}
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {upcoming.slice(0, 24).map((event) => <EventCard event={event} />)}
      </div>
    </section>
  )}

  <div id="explore"></div>
  <EventsExplorer client:load baseUrl={base} />
</BaseLayout>
